{
  "name": "crystaldaking/modx-installer",
  "description": "One command to create a local MODX Revolution site with Docker.",
  "type": "project",
  "license": "MIT",
  "keywords": ["modx", "cli", "docker", "installer"],
  "homepage": "https://github.com/crystaldaking/modx-installer",
  "support": {"issues": "https://github.com/crystaldaking/modx-installer/issues", "source": "https://github.com/crystaldaking/modx-installer"},
  "authors": [{"name": "crystal", "email": "crystal@crystalapps.by"}],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-zip": "*",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/filesystem": "^7.4",
    "symfony/process": "^7.4"
  },
  "require-dev": {"phpunit/phpunit": "^11.5", "symfony/yaml": "^7.4"},
  "autoload": {"psr-4": {"ModxInstaller\\": "src/"}},
  "autoload-dev": {"psr-4": {"ModxInstaller\\Tests\\": "tests/"}},
  "bin": ["bin/modx"],
  "scripts": {"test": "phpunit", "build": "@php -d phar.readonly=0 scripts/build-phar.php", "lint": "@php scripts/lint.php"},
  "config": {"sort-packages": true, "platform": {"php": "8.2.0"}, "allow-plugins": {}}
}
